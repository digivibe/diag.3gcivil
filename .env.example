# Demande de diagnostic (app/api/devis/route.ts) : envoi par e-mail via Resend (https://resend.com).
# Sans clé, le formulaire reste utilisable et propose l'envoi par la messagerie du visiteur.
RESEND_API_KEY=
# Destinataire des demandes (par défaut : hello@3gcivil.com).
DEVIS_EMAIL_TO=
# Expéditeur sur un domaine vérifié chez Resend, ex. "3G CIVIL <diagnostic@groupe3g.fr>".
DEVIS_EMAIL_FROM=
